  duration_ms                Int?
  created_at                 DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                   @default(now()) @db.Timestamptz(6)
  platform_webhook_endpoints platform_webhook_endpoints @relation(fields: [endpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_platform_webhook_deliveries_created")
  @@index([next_attempt_at], map: "idx_platform_webhook_deliveries_due", where: raw("(status = 'pending'::text)"))
  @@index([endpoint_id, created_at(sort: Desc)], map: "idx_platform_webhook_deliveries_endpoint")
}
