/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_agents {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id        String          @default(dbgenerated("active_ws()")) @db.Uuid
  name                String
  avatar_url          String?
  persona             String?
  tone                String          @default("friendly")
  instructions        String?
  language            String          @default("auto")
  skills              String[]        @default(["faq", "handover"])
  greeting_message    String?
  after_hours_message String?
  escalation_keywords String[]        @default(["humano", "agente", "asesor", "human", "agent"])
  business_hours_only Boolean         @default(false)
  model               String?
  enabled             Boolean         @default(true)
  created_by          String?         @default(dbgenerated("app_user_id()")) @db.Uuid
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?       @default(now()) @db.Timestamptz(6)
  description         String?
  transfer_agent_ids  String[]        @default([]) @db.Uuid
  training_context    String?
  handover_mode       String          @default("auto")
  handover_user_id    String?         @db.Uuid
  handover_team_id    String?         @db.Uuid
  users               users?          @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  handover_user       users?          @relation("ai_agents_handover_user", fields: [handover_user_id], references: [id], onUpdate: NoAction)
  handover_team       teams?          @relation(fields: [handover_team_id], references: [id], onUpdate: NoAction)
  workspaces          workspaces      @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_chat_logs        ai_chat_logs[]
  ai_usage            ai_usage[]
  bookings            bookings[]
  channels            channels[]
  conversations       conversations[]
  messages            messages[]
  orders              orders[]

  @@index([workspace_id], map: "idx_ai_agents_workspace")
}

model ai_chat_logs {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id       String         @db.Uuid
  user_message     String
  ai_response      String
  detected_intent  String?
  confidence_score Decimal?       @db.Decimal(3, 2)
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  workspace_id     String         @default(dbgenerated("active_ws()")) @db.Uuid
  ai_agent_id      String?        @db.Uuid
  conversation_id  String?        @db.Uuid
  channel_id       String?        @db.Uuid
  ai_agents        ai_agents?     @relation(fields: [ai_agent_id], references: [id], onUpdate: NoAction)
  channels         channels?      @relation(fields: [channel_id], references: [id], onUpdate: NoAction)
  conversations    conversations? @relation(fields: [conversation_id], references: [id], onUpdate: NoAction)
  contacts         contacts       @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_chat_logs_patient_id_fkey")
  workspaces       workspaces     @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id], map: "idx_ai_chat_logs_workspace")
  @@index([workspace_id, created_at(sort: Desc)], map: "idx_ai_chat_logs_ws_created")
  @@index([workspace_id, detected_intent, created_at], map: "idx_ai_chat_logs_ws_intent")
}

model ai_usage {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id        String         @db.Uuid
  ai_agent_id         String?        @db.Uuid
  conversation_id     String?        @db.Uuid
  channel_id          String?        @db.Uuid
  purpose             String
  provider            String
  model               String
  input_tokens        Int            @default(0)
  cached_input_tokens Int            @default(0)
  output_tokens       Int            @default(0)
  cost_usd            Decimal        @default(0) @db.Decimal(14, 8)
  latency_ms          Int?
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  audio_seconds       Decimal?       @db.Decimal(10, 2)
  ai_agents           ai_agents?     @relation(fields: [ai_agent_id], references: [id], onUpdate: NoAction)
  channels            channels?      @relation(fields: [channel_id], references: [id], onUpdate: NoAction)
  conversations       conversations? @relation(fields: [conversation_id], references: [id], onUpdate: NoAction)
  workspaces          workspaces     @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_ai_usage_created")
  @@index([workspace_id, created_at(sort: Desc)], map: "idx_ai_usage_ws_created")
}

