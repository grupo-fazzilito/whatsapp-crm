# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# PostgreSQL (Railway Postgres or any PostgreSQL 14+). Local:
#   npm run db:up  →  postgresql://crm:crm@127.0.0.1:5434/crm
# Apply the schema with `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_POOL_MAX=10

# Login (Better Auth). Long random string: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me
# Public URL of the app (defaults to NEXT_PUBLIC_SITE_URL).
# BETTER_AUTH_URL=https://app.example.com

# File storage: local disk for development, any S3-compatible service in
# production (Railway Buckets, Cloudflare R2, AWS S3, MinIO).
STORAGE_DRIVER=local
# STORAGE_DIR=.storage
# S3_ENDPOINT=https://...
# S3_REGION=auto
# S3_BUCKET=...
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false
# Signs private file links; defaults to ENCRYPTION_KEY.
# STORAGE_SIGNING_SECRET=...
# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=encryption-key

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

NEXT_PUBLIC_SITE_URL=https://chatnextgen.online

# ============================================================
# CHANNELS (WhatsApp, Instagram, Messenger, TikTok, web chat)
# ============================================================

# Meta App ID (same app as META_APP_SECRET). Enables "Continue with
# Facebook" in Channels to connect Facebook pages (Messenger) and
# Instagram accounts. Without it, admins connect them manually with a
# page token. OAuth redirect URI to whitelist in the app:
#   {your-domain}/api/channels/meta/oauth/callback
# META_APP_ID=your-meta-app-id
# Optional: Facebook Login for Business configuration id (otherwise the
# required scopes are requested directly).
# META_LOGIN_CONFIG_ID=

# Platform-wide webhook verify token for {your-domain}/api/webhooks/meta
# (the one callback URL for WhatsApp, Messenger and Instagram). Each
# WhatsApp channel may also have its own verify token.
# META_VERIFY_TOKEN=generate-a-long-random-string

# TikTok Business Messaging requires approval from TikTok. Keep false
# until you have API access; the TikTok option shows "coming soon".
# TIKTOK_MESSAGING_ENABLED=false

# Comma-separated emails that get the platform admin panel.
# PLATFORM_ADMIN_EMAILS=you@example.com



# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# ============================================================
# AI HEALTHCARE AUTOMATION — API Keys
# ============================================================

# Google Gemini API Key (PRIMARY — required for AI auto-replies).
# Get it from: https://aistudio.google.com/app/apikey
# The AI service tries Gemini first (gemini-1.5-flash → gemini-2.0-flash),
# then falls back to OpenAI below if Gemini is unavailable.
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API Key (FALLBACK — optional but recommended for resilience).
# Also supports OpenRouter keys (sk-or-v1-...) to access GPT-4o-mini via
# OpenRouter. If neither key is set, AI auto-replies are disabled.
OPENAI_API_KEY=your-openai-api-key

# DeepSeek API key (optional provider). Get it from https://platform.deepseek.com
# DeepSeek uses the OpenAI-compatible chat API; model defaults to deepseek-flash (see api-docs.deepseek.com for current names).
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Order in which AI providers are tried (the first that answers wins).
# Only providers with a key are used. Default: gemini,deepseek,openai.
# An AI agent's own "model" setting (gemini-…, deepseek-…, gpt-…) moves
# that provider to the front for that agent.
# AI_PROVIDER_ORDER=deepseek,gemini,openai

# Google Sheets Webhook URL (OPTIONAL — for syncing booked appointments).
# Deploy the Google Apps Script in docs/google-sheets-script.js as a Web App
# (Execute as: Me, Who has access: Anyone), copy the /exec URL here.
# If unset, appointments are saved to the database only (no Sheets sync).
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Payment Latam (AI credit top-ups). Optional: the platform admin panel
# (Settings → Credits and Payment Latam) takes precedence over these.
PAYMENT_LATAM_BASE_URL=https://pay-met.pe:8093
PAYMENT_LATAM_MERCHANT=
PAYMENT_LATAM_USER=
PAYMENT_LATAM_PASS=
